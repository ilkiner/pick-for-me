# Supabase Configuration
# Replace these with your actual Supabase project details
# You can find these in your Supabase Dashboard -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — Subscriptions/IAP (optional, leave empty for demo mode)
# https://app.revenuecat.com → Project Settings → API Keys (public SDK keys)
EXPO_PUBLIC_REVENUECAT_KEY_IOS=
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=

# Sentry — Error monitoring (optional, leave empty to disable)
# https://sentry.io → New Project → React Native → DSN
EXPO_PUBLIC_SENTRY_DSN=

# PostHog — Product analytics (optional, leave empty to disable)
# https://eu.posthog.com → New Project → API Key
EXPO_PUBLIC_POSTHOG_KEY=

# AdMob ad unit IDs (production only — __DEV__ builds always use Google test IDs)
# https://apps.admob.com → Apps → Ad units. If left empty in production,
# that ad format is silently disabled (with a console warning).
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=
EXPO_PUBLIC_ADMOB_REWARDED_ANDROID=
EXPO_PUBLIC_ADMOB_REWARDED_IOS=

# Force Google's universal TEST ad units (set to exactly "true"). Use this for
# internal test builds handed to a group of testers: a preview build is a release
# build, so __DEV__ is false and the real ad units would otherwise serve REAL ads —
# every tester impression and tap counts as invalid traffic against your AdMob
# account. With this on, testers still see ad placement and sizing, but the build
# generates no real impressions at all.
#
# Trade-off: the real ad unit's configuration (fill rate, mediation) goes untested.
# Register test devices below instead if you need to verify that.
#
# Set ONLY in the preview EAS environment. Never in production — it would stop the
# app earning. Only the exact string "true" enables it.
EXPO_PUBLIC_ADMOB_FORCE_TEST_UNITS=

# AdMob test device IDs (comma separated). Set this ONLY in the development and
# preview EAS environments — never in production. Internal-test builds are
# release builds, so __DEV__ is false and the real ad units are used; without
# this your own taps count as invalid traffic. Registering the device keeps the
# real ad unit but serves test ads to it.
# Find the ID in logcat / the Xcode console on the first ad request:
#   Use RequestConfiguration.Builder.setTestDeviceIds(Arrays.asList("33BE2250..."))
EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
